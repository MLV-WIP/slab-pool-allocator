#!/bin/bash
#
# Configure script for Slab Pool Allocator
# Detects system capabilities and generates appropriate Makefile
#

set -e  # Exit on error

# Color output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Default values
PREFIX="/usr/local"
CXX=""
CXXFLAGS=""
BUILD_TYPE="release"
ENABLE_TESTS="yes"
ENABLE_DEMO="yes"
GTEST_DIR=""
ENABLE_ASAN="auto"
ENABLE_LSAN="auto"
ENABLE_MSAN="auto"
ENABLE_UBSAN="auto"
ENABLE_TSAN="no"
ENABLE_COVERAGE="auto"
VERBOSE="no"
SLAB_TARGET_BYTES="8192"
SLAB_TARGET_MULTIPLIER="16"
MAX_ALLOCATION_MIB="1024"           # 1 GiB
MAX_CLASS_MIB="4096"                # 4 GiB
# Empty => auto-select newest of c++26/c++23/c++20. Set via --with-cxxstd=.
REQUESTED_CXXSTD=""

# Detected values
DETECTED_CXX=""
DETECTED_GTEST=""
IS_CLANG="no"
HAS_CXX20="no"
HAS_CXX23="no"
HAS_CXX26="no"
CXXSTD="-std=c++20"
HAS_FORMAT="no"
HAS_PRINT="no"
HAS_RANGES="no"
HAS_ATOMIC_WAIT="no"

# Functions
print_info() {
    echo -e "${BLUE}[INFO]${NC} $1"
}

print_success() {
    echo -e "${GREEN}[OK]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

usage() {
    cat << EOF
Usage: ./configure [OPTION]...

Configuration:
  --prefix=PREFIX         installation prefix [$PREFIX]
  --build-type=TYPE       build type: debug, release, memsan, threadsan [$BUILD_TYPE]

Optional Features:
  --enable-tests          build test suite [default: yes]
  --disable-tests         do not build test suite
  --enable-demo           build demo programs [default: yes]
  --disable-demo          do not build demo programs
  --enable-asan           enable AddressSanitizer [default: auto]
  --disable-asan          disable AddressSanitizer
  --enable-lsan           enable LeakSanitizer [default: auto]
  --disable-lsan          disable LeakSanitizer
  --enable-msan           enable MemorySanitizer [default: auto]
  --disable-msan          disable MemorySanitizer
  --enable-ubsan          enable UndefinedBehaviorSanitizer [default: auto]
  --disable-ubsan         disable UndefinedBehaviorSanitizer
  --enable-tsan           enable ThreadSanitizer [default: no]
  --enable-coverage       enable code coverage instrumentation [default: auto;
                          yes for --build-type=release]
  --disable-coverage      disable code coverage instrumentation
  --enable-verbose        verbose output during build [default: no]

Optional Packages:
  --with-gtest=DIR        Google Test installation directory
  --with-cxx=COMPILER     C++ compiler to use (g++, clang++, etc.)
  --with-cxxflags=FLAGS   additional C++ compiler flags
  --with-cxxstd=STD       C++ dialect: auto, c++20, c++23, or c++26
                          [default: auto — newest the compiler accepts]
  --with-slab-target-bytes=N
                          slab buffer soft target in bytes (power of two)
                          [default: 8192]
  --with-slab-target-multiplier=N
                          minimum slots per slab buffer (minimum 4)
                          [default: 16]
  --with-max-allocation-mib=N
                          compile-time max single allocation in MiB (1024^2)
                          [default: 1024]
  --with-max-class-mib=N
                          compile-time max retained per size class in MiB
                          [default: 4096]

Examples:
  ./configure
  ./configure --build-type=debug --enable-tsan
  ./configure --with-gtest=/usr/local --disable-tests
  ./configure --prefix=/opt/spallocator --build-type=release
  ./configure --with-slab-target-bytes=16384 --with-slab-target-multiplier=16
  ./configure --with-max-allocation-mib=256 --with-max-class-mib=1024
  ./configure --with-cxxstd=c++20
  ./configure --with-cxxstd=auto

EOF
}

# Parse command line arguments
for arg in "$@"; do
    case $arg in
        --help|-h)
            usage
            exit 0
            ;;
        --prefix=*)
            PREFIX="${arg#*=}"
            ;;
        --build-type=*)
            BUILD_TYPE="${arg#*=}"
            ;;
        --enable-tests)
            ENABLE_TESTS="yes"
            ;;
        --disable-tests)
            ENABLE_TESTS="no"
            ;;
        --enable-demo)
            ENABLE_DEMO="yes"
            ;;
        --disable-demo)
            ENABLE_DEMO="no"
            ;;
        --enable-asan)
            ENABLE_ASAN="yes"
            ;;
        --disable-asan)
            ENABLE_ASAN="no"
            ;;
        --enable-lsan)
            ENABLE_LSAN="yes"
            ;;
        --disable-lsan)
            ENABLE_LSAN="no"
            ;;
        --enable-msan)
            ENABLE_MSAN="yes"
            ;;
        --disable-msan)
            ENABLE_MSAN="no"
            ;;
        --enable-ubsan)
            ENABLE_UBSAN="yes"
            ;;
        --disable-ubsan)
            ENABLE_UBSAN="no"
            ;;
        --enable-tsan)
            ENABLE_TSAN="yes"
            ;;
        --enable-coverage)
            ENABLE_COVERAGE="yes"
            ;;
        --disable-coverage)
            ENABLE_COVERAGE="no"
            ;;
        --enable-verbose)
            VERBOSE="yes"
            ;;
        --with-gtest=*)
            GTEST_DIR="${arg#*=}"
            ;;
        --with-cxx=*)
            CXX="${arg#*=}"
            ;;
        --with-cxxflags=*)
            CXXFLAGS="${arg#*=}"
            ;;
        --with-cxxstd=*)
            REQUESTED_CXXSTD="${arg#*=}"
            ;;
        --with-slab-target-bytes=*)
            SLAB_TARGET_BYTES="${arg#*=}"
            ;;
        --with-slab-target-multiplier=*)
            SLAB_TARGET_MULTIPLIER="${arg#*=}"
            ;;
        --with-max-allocation-mib=*)
            MAX_ALLOCATION_MIB="${arg#*=}"
            ;;
        --with-max-class-mib=*)
            MAX_CLASS_MIB="${arg#*=}"
            ;;
        *)
            print_error "Unknown option: $arg"
            usage
            exit 1
            ;;
    esac
done

# Light validation of compile-time size knobs (static_assert is authoritative).
if ! [[ "$SLAB_TARGET_BYTES" =~ ^[1-9][0-9]*$ ]]; then
    print_error "--with-slab-target-bytes must be a positive integer (got: $SLAB_TARGET_BYTES)"
    exit 1
fi
if ! [[ "$SLAB_TARGET_MULTIPLIER" =~ ^[1-9][0-9]*$ ]]; then
    print_error "--with-slab-target-multiplier must be a positive integer (got: $SLAB_TARGET_MULTIPLIER)"
    exit 1
fi
if [ "$SLAB_TARGET_MULTIPLIER" -lt 4 ]; then
    print_error "--with-slab-target-multiplier must be >= 4 (got: $SLAB_TARGET_MULTIPLIER)"
    exit 1
fi
if [ $((SLAB_TARGET_BYTES & (SLAB_TARGET_BYTES - 1))) -ne 0 ]; then
    print_error "--with-slab-target-bytes must be a power of two (got: $SLAB_TARGET_BYTES)"
    exit 1
fi
if ! [[ "$MAX_ALLOCATION_MIB" =~ ^[1-9][0-9]*$ ]]; then
    print_error "--with-max-allocation-mib must be a positive integer (got: $MAX_ALLOCATION_MIB)"
    exit 1
fi
if ! [[ "$MAX_CLASS_MIB" =~ ^[1-9][0-9]*$ ]]; then
    print_error "--with-max-class-mib must be a positive integer (got: $MAX_CLASS_MIB)"
    exit 1
fi
# 1 MiB already exceeds helper.hpp floors (4096+64 / 16*4096).
if [ "$MAX_CLASS_MIB" -lt "$MAX_ALLOCATION_MIB" ]; then
    print_error "--with-max-class-mib ($MAX_CLASS_MIB) must be >= --with-max-allocation-mib ($MAX_ALLOCATION_MIB)"
    exit 1
fi
MAX_ALLOCATION_BYTES=$((MAX_ALLOCATION_MIB * 1024 * 1024))
MAX_CLASS_BYTES=$((MAX_CLASS_MIB * 1024 * 1024))

# Validate build type
case $BUILD_TYPE in
    debug|release|addrsan|memsan|threadsan)
        ;;
    *)
        print_error "Invalid build type: $BUILD_TYPE"
        print_error "Valid types: debug, release, addrsan, memsan, threadsan"
        exit 1
        ;;
esac

# Auto-detect sanitizers for build type
if [ "$BUILD_TYPE" = "addrsan" ]; then
    ENABLE_ASAN="yes"
    [ "$ENABLE_LSAN" = "auto" ] && ENABLE_LSAN="yes"
    [ "$ENABLE_UBSAN" = "auto" ] && ENABLE_UBSAN="yes"
    ENABLE_MSAN="no"
    ENABLE_TSAN="no"
elif [ "$BUILD_TYPE" = "memsan" ]; then
    ENABLE_MSAN="yes"
    [ "$ENABLE_UBSAN" = "auto" ] && ENABLE_UBSAN="yes"
    ENABLE_ASAN="no"
    ENABLE_LSAN="no"
    ENABLE_TSAN="no"
elif [ "$BUILD_TYPE" = "threadsan" ]; then
    ENABLE_TSAN="yes"
    ENABLE_ASAN="no"  # Can't use ASan and TSan together
    ENABLE_LSAN="no"  # Can't use LSan and TSan together
    ENABLE_MSAN="no"
    # UBSan+TSan together produces intermittent false races in GCC libstdc++
    # std::thread teardown (IsAccessibleMemoryRange/pipe). Opt in explicitly.
    [ "$ENABLE_UBSAN" = "auto" ] && ENABLE_UBSAN="no"
else
    [ "$ENABLE_ASAN" = "auto" ] && ENABLE_ASAN="no"
    [ "$ENABLE_LSAN" = "auto" ] && ENABLE_LSAN="no"
    [ "$ENABLE_UBSAN" = "auto" ] && ENABLE_UBSAN="no"
    [ "$ENABLE_MSAN" = "auto" ] && ENABLE_MSAN="no"
    [ "$ENABLE_TSAN" = "auto" ] && ENABLE_TSAN="no"
fi

# ASan (incl. LSan), MSan, and TSan are mutually exclusive instrumentors.
# UBsan may combine with any of them. Sanitizer BUILD_TYPEs already clear
# the others above; this catches explicit --enable-* clashes on debug/release.
asan_family=no
msan_on=no
tsan_on=no
[ "$ENABLE_ASAN" = "yes" ] || [ "$ENABLE_LSAN" = "yes" ] && asan_family=yes
[ "$ENABLE_MSAN" = "yes" ] && msan_on=yes
[ "$ENABLE_TSAN" = "yes" ] && tsan_on=yes
exclusive_count=0
[ "$asan_family" = "yes" ] && exclusive_count=$((exclusive_count + 1))
[ "$msan_on" = "yes" ] && exclusive_count=$((exclusive_count + 1))
[ "$tsan_on" = "yes" ] && exclusive_count=$((exclusive_count + 1))
if [ "$exclusive_count" -gt 1 ]; then
    print_error "Incompatible sanitizers requested (ASan/LSan, MSan, and TSan are mutually exclusive)"
    print_error "  Address/Leak: $ENABLE_ASAN / $ENABLE_LSAN"
    print_error "  Memory:       $ENABLE_MSAN"
    print_error "  Thread:       $ENABLE_TSAN"
    print_error "Use a single sanitizer build type: --build-type=addrsan|memsan|threadsan"
    exit 1
fi

# Coverage: default on for release (CI + local optimized/NDEBUG builds), off otherwise.
if [ "$ENABLE_COVERAGE" = "auto" ]; then
    if [ "$BUILD_TYPE" = "release" ]; then
        ENABLE_COVERAGE="yes"
    else
        ENABLE_COVERAGE="no"
    fi
fi

print_info "Configuring Slab Pool Allocator..."
echo ""

# Detect C++ compiler
print_info "Detecting C++ compiler..."
if [ -n "$CXX" ]; then
    if ! command -v "$CXX" &> /dev/null; then
        print_error "Specified compiler not found: $CXX"
        exit 1
    fi
    DETECTED_CXX="$CXX"
    print_success "Using specified compiler: $DETECTED_CXX"
else
    for compiler in c++ clang++ g++; do
        if command -v "$compiler" &> /dev/null; then
            DETECTED_CXX="$compiler"
            print_success "Found compiler: $DETECTED_CXX"
            break
        fi
    done

    if [ -z "$DETECTED_CXX" ]; then
        print_error "No C++ compiler found!"
        print_error "Please install g++, clang++, or specify with --with-cxx="
        exit 1
    fi
fi

# Get compiler version
CXX_VERSION=$($DETECTED_CXX --version | head -n1)
print_info "Compiler version: $CXX_VERSION"

# Check if compiler is clang
if $DETECTED_CXX --version | grep -q "clang"; then
    IS_CLANG="yes"
fi

# Probe dialects and select one. Acceptance is "does -std=… compile a trivial
# TU?" — early -std=c++26 toolchains may still report a C++23 __cplusplus.
# --with-cxxstd= pins the choice; otherwise pick newest of 26/23/20.
print_info "Selecting C++ language dialect..."
cat > conftest.cpp << 'EOF'
int main() { return 0; }
EOF

if $DETECTED_CXX -std=c++20 conftest.cpp -o conftest 2>/dev/null; then
    HAS_CXX20="yes"
else
    HAS_CXX20="no"
fi
rm -f conftest conftest.o

if $DETECTED_CXX -std=c++23 conftest.cpp -o conftest 2>/dev/null; then
    HAS_CXX23="yes"
else
    HAS_CXX23="no"
fi
rm -f conftest conftest.o

if $DETECTED_CXX -std=c++26 conftest.cpp -o conftest 2>/dev/null; then
    HAS_CXX26="yes"
else
    HAS_CXX26="no"
fi
rm -f conftest.cpp conftest conftest.o

if [ "$HAS_CXX20" != "yes" ]; then
    print_error "C++20 support: no"
    print_error "This project requires at least C++20"
    print_error "Please upgrade your compiler or use --with-cxx= to specify a newer one"
    exit 1
fi

normalize_cxxstd() {
    # Accept c++20 / 20 / -std=c++20 (and 23/26). Echo canonical -std=c++XX.
    # "auto" is handled by the caller (same as omitting --with-cxxstd).
    local raw="$1"
    raw=$(echo "$raw" | tr '[:upper:]' '[:lower:]')
    raw="${raw#-std=}"
    case "$raw" in
        c++20|20|gnu++20)
            echo "-std=c++20"
            ;;
        c++23|23|gnu++23)
            echo "-std=c++23"
            ;;
        c++26|26|gnu++26)
            echo "-std=c++26"
            ;;
        *)
            return 1
            ;;
    esac
}

# Treat omitted and explicit --with-cxxstd=auto the same.
REQUESTED_CXXSTD_NORM=$(echo "$REQUESTED_CXXSTD" | tr '[:upper:]' '[:lower:]')
if [ -n "$REQUESTED_CXXSTD" ] && [ "$REQUESTED_CXXSTD_NORM" != "auto" ]; then
    if ! CXXSTD=$(normalize_cxxstd "$REQUESTED_CXXSTD"); then
        print_error "--with-cxxstd must be auto, c++20, c++23, or c++26 (got: $REQUESTED_CXXSTD)"
        exit 1
    fi
    case "$CXXSTD" in
        -std=c++20)
            if [ "$HAS_CXX20" != "yes" ]; then
                print_error "Requested $CXXSTD but the compiler rejected it"
                exit 1
            fi
            ;;
        -std=c++23)
            if [ "$HAS_CXX23" != "yes" ]; then
                print_error "Requested $CXXSTD but the compiler rejected it"
                exit 1
            fi
            ;;
        -std=c++26)
            if [ "$HAS_CXX26" != "yes" ]; then
                print_error "Requested $CXXSTD but the compiler rejected it"
                exit 1
            fi
            ;;
    esac
    print_success "Dialect: $CXXSTD (requested via --with-cxxstd)"
elif [ "$HAS_CXX26" = "yes" ]; then
    CXXSTD="-std=c++26"
    print_success "Dialect: C++26 (auto)"
elif [ "$HAS_CXX23" = "yes" ]; then
    CXXSTD="-std=c++23"
    print_success "Dialect: C++23 (auto)"
else
    CXXSTD="-std=c++20"
    print_success "Dialect: C++20 (auto)"
fi

# Library feature probes use the selected dialect.
# std::format is required (no polyfill); early C++20 libcs often lacked it.
print_info "Checking for std::format..."
cat > conftest.cpp << 'EOF'
#include <version>
#include <format>
#if !defined(__cpp_lib_format) || __cpp_lib_format < 201907L
#error "std::format feature-test macro missing or too old"
#endif
int main() {
    auto s = std::format("test {}", 42);
    return static_cast<int>(s.size());
}
EOF

if $DETECTED_CXX $CXXSTD conftest.cpp -o conftest 2>/dev/null; then
    HAS_FORMAT="yes"
    print_success "std::format: yes"
else
    HAS_FORMAT="no"
    print_error "std::format: no"
    print_error "A working <format> implementation is required (C++20 library completeness)."
    print_error "Upgrade libstdc++/libc++ or the compiler; this project does not vendor a format polyfill."
    rm -f conftest.cpp conftest
    exit 1
fi
rm -f conftest.cpp conftest conftest.o

# std::print is optional (C++23); headers feature-test and fall back if absent.
print_info "Checking for std::print..."
cat > conftest.cpp << 'EOF'
#include <version>
#if !defined(__cpp_lib_print) || __cpp_lib_print < 202207L
#error "std::print not available"
#endif
#include <print>
int main() {
    std::print("{}", 42);
    return 0;
}
EOF

if $DETECTED_CXX $CXXSTD conftest.cpp -o conftest 2>/dev/null; then
    HAS_PRINT="yes"
    print_success "std::print: yes"
else
    HAS_PRINT="no"
    print_warning "std::print: no (headers will use a std::format-based shim)"
fi
rm -f conftest.cpp conftest conftest.o

# Check for std::ranges
print_info "Checking for std::ranges..."
cat > conftest.cpp << 'EOF'
#include <ranges>
#include <vector>
int main() {
    std::vector<int> v = {1, 2, 3};
    auto r = v | std::views::reverse;
    return 0;
}
EOF

if $DETECTED_CXX $CXXSTD conftest.cpp -o conftest 2>/dev/null; then
    HAS_RANGES="yes"
    print_success "std::ranges: yes"
else
    HAS_RANGES="no"
    print_error "std::ranges: no"
    print_error "This project requires std::ranges support"
    rm -f conftest.cpp conftest
    exit 1
fi
rm -f conftest.cpp conftest conftest.o

# Check for atomic_flag::wait
print_info "Checking for atomic_flag::wait..."
cat > conftest.cpp << 'EOF'
#include <atomic>
int main() {
    std::atomic_flag flag = ATOMIC_FLAG_INIT;
    flag.test_and_set();
    flag.wait(true);
    flag.clear();
    flag.notify_one();
    return 0;
}
EOF

if $DETECTED_CXX $CXXSTD conftest.cpp -o conftest 2>/dev/null; then
    HAS_ATOMIC_WAIT="yes"
    print_success "atomic_flag::wait: yes"
else
    HAS_ATOMIC_WAIT="no"
    print_error "atomic_flag::wait: no"
    print_error "This project requires C++20 atomic wait/notify support"
    rm -f conftest.cpp conftest
    exit 1
fi
rm -f conftest.cpp conftest conftest.o

# Detect Google Test
if [ "$ENABLE_TESTS" = "yes" ]; then
    print_info "Detecting Google Test..."

    if [ -n "$GTEST_DIR" ]; then
        if [ -d "$GTEST_DIR" ]; then
            DETECTED_GTEST="$GTEST_DIR"
            print_success "Using specified Google Test: $DETECTED_GTEST"
        else
            print_error "Specified Google Test directory not found: $GTEST_DIR"
            exit 1
        fi
    else
        # Try common locations
        for dir in /opt/homebrew/Cellar/googletest/* /usr/local /usr /opt/local; do
            if [ -f "$dir/include/gtest/gtest.h" ]; then
                DETECTED_GTEST="$dir"
                print_success "Found Google Test: $DETECTED_GTEST"
                break
            fi
        done

        if [ -z "$DETECTED_GTEST" ]; then
            print_warning "Google Test not found"
            print_warning "Tests will be disabled. Install with:"
            print_warning "  brew install googletest  (macOS)"
            print_warning "  apt install libgtest-dev (Ubuntu)"
            print_warning "Or specify with --with-gtest=DIR"
            ENABLE_TESTS="no"
        fi
    fi
fi

# Check sanitizer support
if [ "$ENABLE_ASAN" = "yes" ] || [ "$ENABLE_LSAN" = "yes" ] || [ "$ENABLE_UBSAN" = "yes" ] || [ "$ENABLE_TSAN" = "yes" ]; then
    print_info "Checking sanitizer support..."

    if [ "$ENABLE_ASAN" = "yes" ]; then
        cat > conftest.cpp << 'EOF'
int main() { return 0; }
EOF
        TEST_CXXFLAGS="$CXXSTD -fsanitize=address"
        if $DETECTED_CXX $TEST_CXXFLAGS conftest.cpp -o conftest 2>/dev/null; then
            print_success "AddressSanitizer: yes"
        else
            print_warning "AddressSanitizer not supported by this compiler"
            ENABLE_ASAN="no"
        fi
        rm -f conftest.cpp conftest conftest.o
    fi

    if [ "$ENABLE_LSAN" = "yes" ]; then
        cat > conftest.cpp << 'EOF'
int main() { return 0; }
EOF
        TEST_CXXFLAGS="$CXXSTD -fsanitize=leak"
        if $DETECTED_CXX $TEST_CXXFLAGS conftest.cpp -o conftest 2>/dev/null; then
            print_success "LeakSanitizer: yes"
        else
            print_warning "LeakSanitizer not supported by this compiler"
            ENABLE_LSAN="no"
        fi
        rm -f conftest.cpp conftest conftest.o
    fi

    if [ "$ENABLE_MSAN" = "yes" ]; then
        cat > conftest.cpp << 'EOF'
int main() { return 0; }
EOF
        TEST_CXXFLAGS="$CXXSTD -fsanitize=memory"
        if $DETECTED_CXX $TEST_CXXFLAGS conftest.cpp -o conftest 2>/dev/null; then
            print_success "MemorySanitizer: yes"
        else
            print_warning "MemorySanitizer not supported by this compiler"
            ENABLE_MSAN="no"
        fi
        rm -f conftest.cpp conftest conftest.o
    fi

    if [ "$ENABLE_TSAN" = "yes" ]; then
        cat > conftest.cpp << 'EOF'
int main() { return 0; }
EOF
        TEST_CXXFLAGS="$CXXSTD -fsanitize=thread"
        if $DETECTED_CXX $TEST_CXXFLAGS conftest.cpp -o conftest 2>/dev/null; then
            print_success "ThreadSanitizer: yes"
        else
            print_warning "ThreadSanitizer not supported by this compiler"
            ENABLE_TSAN="no"
        fi
        rm -f conftest.cpp conftest conftest.o
    fi
fi

echo ""
print_info "Configuration summary:"
echo "  Prefix:               $PREFIX"
echo "  Build type:           $BUILD_TYPE"
echo "  C++ Compiler:         $DETECTED_CXX"
if [ -n "$REQUESTED_CXXSTD" ] && [ "$(echo "$REQUESTED_CXXSTD" | tr '[:upper:]' '[:lower:]')" != "auto" ]; then
echo "  C++ dialect:          $CXXSTD (requested)"
else
echo "  C++ dialect:          $CXXSTD (auto)"
fi
echo "  C++20 support:        $HAS_CXX20"
echo "  C++23 support:        $HAS_CXX23"
echo "  C++26 support:        $HAS_CXX26"
echo "  std::format:          $HAS_FORMAT"
echo "  std::print:           $HAS_PRINT"
echo "  std::ranges:          $HAS_RANGES"
echo "  atomic wait/notify:   $HAS_ATOMIC_WAIT"
echo "  Build tests:          $ENABLE_TESTS"
if [ "$ENABLE_TESTS" = "yes" ]; then
echo "  Google Test:          $DETECTED_GTEST"
fi
echo "  Build demo:           $ENABLE_DEMO"
echo "  AddressSanitizer:     $ENABLE_ASAN"
echo "  LeakSanitizer:        $ENABLE_LSAN"
echo "  MemorySanitizer:      $ENABLE_MSAN"
echo "  UBSanitizer:          $ENABLE_UBSAN"
echo "  ThreadSanitizer:      $ENABLE_TSAN"
echo "  Code coverage:        $ENABLE_COVERAGE"
echo "  Slab target bytes:    $SLAB_TARGET_BYTES"
echo "  Slab target mult:     $SLAB_TARGET_MULTIPLIER"
echo "  Max allocation MiB:   $MAX_ALLOCATION_MIB ($MAX_ALLOCATION_BYTES bytes)"
echo "  Max class MiB:        $MAX_CLASS_MIB ($MAX_CLASS_BYTES bytes)"
echo ""

# Generate config.mk
print_info "Generating config.mk..."

# Append size knobs as -D so headers' #ifndef defaults are overridden.
SIZE_CXXFLAGS="-DSPALLOCATOR_SLAB_TARGET_BYTES=$SLAB_TARGET_BYTES -DSPALLOCATOR_SLAB_TARGET_MULTIPLIER=$SLAB_TARGET_MULTIPLIER -DSPALLOCATOR_MAX_ALLOCATION_BYTES=$MAX_ALLOCATION_BYTES -DSPALLOCATOR_MAX_CLASS_BYTES=$MAX_CLASS_BYTES"
if [ -n "$CXXFLAGS" ]; then
    USER_CXXFLAGS_VALUE="$CXXFLAGS $SIZE_CXXFLAGS"
else
    USER_CXXFLAGS_VALUE="$SIZE_CXXFLAGS"
fi

cat > config.mk << EOF
# Generated by configure - do not edit manually
# To reconfigure, run: ./configure [options]

# Installation
PREFIX := $PREFIX

# Compiler
CXX := $DETECTED_CXX
IS_CLANG := $IS_CLANG
CXXSTD := $CXXSTD

# Build configuration
BUILD_TYPE := $BUILD_TYPE
ENABLE_TESTS := $ENABLE_TESTS
ENABLE_DEMO := $ENABLE_DEMO
VERBOSE := $VERBOSE

# Google Test
GTEST_DIR := $DETECTED_GTEST

# Sanitizers
ENABLE_ASAN := $ENABLE_ASAN
ENABLE_LSAN := $ENABLE_LSAN
ENABLE_MSAN := $ENABLE_MSAN
ENABLE_UBSAN := $ENABLE_UBSAN
ENABLE_TSAN := $ENABLE_TSAN
ENABLE_COVERAGE := $ENABLE_COVERAGE

# Slab buffer packing (compile-time)
SLAB_TARGET_BYTES := $SLAB_TARGET_BYTES
SLAB_TARGET_MULTIPLIER := $SLAB_TARGET_MULTIPLIER

# User-specified flags (+ slab packing -D knobs)
USER_CXXFLAGS := $USER_CXXFLAGS_VALUE

# Feature detection
HAS_CXX20 := $HAS_CXX20
HAS_CXX23 := $HAS_CXX23
HAS_CXX26 := $HAS_CXX26
HAS_FORMAT := $HAS_FORMAT
HAS_PRINT := $HAS_PRINT
EOF

print_success "Configuration complete!"
echo ""
print_info "You can now run:"
echo "  make              - Build the project"
if [ "$ENABLE_TESTS" = "yes" ]; then
echo "  make test         - Run tests"
fi
if [ "$ENABLE_COVERAGE" = "yes" ]; then
echo "  make coverage     - Run tests and print coverage summary"
fi
if [ "$ENABLE_DEMO" = "yes" ]; then
echo "  make demo         - Run demo program"
fi
echo "  make clean        - Clean build artifacts"
echo "  make install      - Install (to $PREFIX)"
echo ""
