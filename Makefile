# Makefile for Slab Pool Allocator
#
# This Makefile can work standalone with defaults or use config.mk generated by ./configure
#

# Include generated configuration if it exists
-include config.mk

# Default values (used if config.mk doesn't exist)
PREFIX ?= /usr/local
CXX ?= c++
IS_CLANG ?= no
BUILD_TYPE ?= addrsan
ENABLE_TESTS ?= yes
ENABLE_DEMO ?= yes
ENABLE_BENCH ?= yes
VERBOSE ?= no
ENABLE_ASAN ?= auto
ENABLE_LSAN ?= auto
ENABLE_MSAN ?= auto
ENABLE_UBSAN ?= auto
ENABLE_TSAN ?= auto
ENABLE_COVERAGE ?= auto

# Bench / profile timings must not be skewed by gcov arc instrumentation.
# `make profile` also forces BUILD_TYPE=profile (release + frame pointers + -g).
ifneq ($(filter profile,$(MAKECMDGOALS)),)
    BUILD_TYPE := profile
endif
ifneq ($(filter bench profile,$(MAKECMDGOALS)),)
    ENABLE_COVERAGE := no
endif

# Auto-detect Google Test if not specified
ifndef GTEST_DIR
    ifneq ($(wildcard /opt/homebrew/Cellar/googletest/*),)
        GTEST_DIR := $(shell ls -d /opt/homebrew/Cellar/googletest/* | head -n1)
    else ifneq ($(wildcard /usr/local/include/gtest),)
        GTEST_DIR := /usr/local
    else ifneq ($(wildcard /usr/include/gtest),)
        GTEST_DIR := /usr
    endif
endif

# Determine if we should enable tests
ifeq ($(GTEST_DIR),)
    ENABLE_TESTS := no
endif

# Base directories
BASEOBJDIR := ./obj
SRCDIR := .
TESTDIR := ./test
DEMODIR := ./demos
BENCHDIR := ./bench
INCLUDEDIR := ./spallocator
MLVLIB_ROOT := ./mlvlib
# Public API / concepts / implementation docs (repo root docs/).
APIDOCS := ./docs

# Compiler flags.
# Prefer CXXSTD from config.mk (./configure picks newest of c++26/23/20).
# Without config.mk, default to the documented minimum.
CXXSTD ?= -std=c++20
# -I. for "spallocator/..."; -Imlvlib for "mlvlib/..." (submodule root).
INCLUDES := -I. -I$(INCLUDEDIR) -I$(MLVLIB_ROOT)
WARNINGS := -Wall -Wextra -Wpedantic -Werror

# Add Google Test includes if tests are enabled
ifeq ($(ENABLE_TESTS),yes)
    INCLUDES += -I$(GTEST_DIR)/include
    LDLIBS := -L$(GTEST_DIR)/lib -lgtest
endif

# Host-tuned codegen (./configure --enable-native-arch is the default).
# --disable-native-arch sets ENABLE_NATIVE_ARCH=no in config.mk.
# Override with MARCH_FLAGS= on the make command line if needed.
ENABLE_NATIVE_ARCH ?= yes
ifeq ($(ENABLE_NATIVE_ARCH),yes)
    MARCH_FLAGS ?= -march=native
    ifeq ($(filter -march=%,$(USER_CXXFLAGS)),)
        USER_CXXFLAGS += $(MARCH_FLAGS)
    endif
endif

# Base flags
CXXFLAGS := $(CXXSTD) $(INCLUDES) $(WARNINGS) -MMD -MP $(USER_CXXFLAGS)
LDFLAGS := $(LDLIBS)


# Build-type specific flags.
# Sanitizer -fsanitize=* flags are applied only inside these mutually exclusive
# BUILD_TYPE branches (addrsan / memsan / threadsan). ASan+LSan+UBSan may
# combine; ASan/LSan, MSan, and TSan never share a branch.
ifeq ($(BUILD_TYPE),debug)
    CXXFLAGS += -DDEBUG -O0 -g -fno-omit-frame-pointer
    LDFLAGS += -g
    OBJDIRNAME := debug
else ifeq ($(BUILD_TYPE),release)
    CXXFLAGS += -DNDEBUG -O3
    LDFLAGS += -O3
    OBJDIRNAME := release
else ifeq ($(BUILD_TYPE),profile)
    # Optimized like release, but keep frame pointers + debug info for perf/Hotspot.
    CXXFLAGS += -DNDEBUG -O3 -g -fno-omit-frame-pointer
    LDFLAGS += -O3 -g
    OBJDIRNAME := profile
    ENABLE_COVERAGE := no
else ifeq ($(BUILD_TYPE),addrsan)
    CXXFLAGS += -DDEBUG -O0 -g -fno-omit-frame-pointer
    LDFLAGS += -g
    OBJDIRNAME := addrsan
    # AddressSanitizer
    ifeq ($(ENABLE_ASAN),yes)
        CXXFLAGS += -fsanitize=address
        LDFLAGS += -fsanitize=address
    else ifeq ($(ENABLE_ASAN),auto)
        CXXFLAGS += -fsanitize=address
        LDFLAGS += -fsanitize=address
    endif
    # LeakSanitizer
	ifeq ($(ENABLE_LSAN),yes)
		CXXFLAGS += -fsanitize=leak
		LDFLAGS += -fsanitize=leak
	else ifeq ($(ENABLE_LSAN),auto)
		CXXFLAGS += -fsanitize=leak
		LDFLAGS += -fsanitize=leak
    endif
    # UndefinedBehaviorSanitizer
    ifeq ($(ENABLE_UBSAN),yes)
        CXXFLAGS += -fsanitize=undefined
        LDFLAGS += -fsanitize=undefined
    else ifeq ($(ENABLE_UBSAN),auto)
        CXXFLAGS += -fsanitize=undefined
        LDFLAGS += -fsanitize=undefined
    endif
else ifeq ($(BUILD_TYPE),memsan)
    CXXFLAGS += -DDEBUG -O0 -g -fno-omit-frame-pointer
    LDFLAGS += -g
    OBJDIRNAME := memsan
    # BUILD_TYPE selects the sanitizer; do not require ENABLE_MSAN=yes from configure.
    # Note: usable MSan needs an instrumented C++ stdlib + gtest; deferred for now.
    # Available locally; omitted from GitHub CI until that is sorted.
    CXXFLAGS += -fsanitize=memory
    LDFLAGS += -fsanitize=memory
    ifeq ($(ENABLE_UBSAN),yes)
        CXXFLAGS += -fsanitize=undefined
        LDFLAGS += -fsanitize=undefined
    else ifeq ($(ENABLE_UBSAN),auto)
        CXXFLAGS += -fsanitize=undefined
        LDFLAGS += -fsanitize=undefined
    endif
else ifeq ($(BUILD_TYPE),threadsan)
    CXXFLAGS += -DDEBUG -O0 -g -fno-omit-frame-pointer
    LDFLAGS += -g
    OBJDIRNAME := threadsan
    # BUILD_TYPE selects the sanitizer; bare `make BUILD_TYPE=threadsan` must
    # not silently omit -fsanitize=thread when ENABLE_TSAN defaults to no/auto
    # or a stale config.mk left it off.
    CXXFLAGS += -fsanitize=thread
    LDFLAGS += -fsanitize=thread
    # UBSan is opt-in only for threadsan (not auto): pairing it with TSan under
    # GCC has produced false-positive races in std::thread state teardown.
    ifeq ($(ENABLE_UBSAN),yes)
        CXXFLAGS += -fsanitize=undefined
        LDFLAGS += -fsanitize=undefined
    endif
endif

# Coverage: release promotes auto → yes (matches configure). Other build types
# need an explicit ENABLE_COVERAGE=yes.
ifeq ($(BUILD_TYPE),release)
    ifeq ($(ENABLE_COVERAGE),auto)
        ENABLE_COVERAGE := yes
    endif
endif
ifeq ($(ENABLE_COVERAGE),yes)
    CXXFLAGS += --coverage -fprofile-arcs -ftest-coverage
    LDFLAGS += --coverage
endif

# Verbose output
ifeq ($(VERBOSE),yes)
    Q :=
    ECHO := @true
	CXXFLAGS += -DVDEBUG
else
    Q := @
    ECHO := @echo
endif

# Object directory
OBJDIR := $(BASEOBJDIR)/$(OBJDIRNAME)

# Source files
TESTER_SRC := $(TESTDIR)/tester.cpp
TESTER_TARGET := tester
TESTER_DEPFILE := $(OBJDIR)/$(TESTER_TARGET).d

DEMO_NAMES := demo_spalloc_shared_ptr demo_pool_pmr
DEMO_TARGETS := $(addprefix $(OBJDIR)/,$(DEMO_NAMES))

BENCH_SRC := $(BENCHDIR)/bench_allocators.cpp
BENCH_TARGET := bench_allocators
BENCH_DEPFILE := $(OBJDIR)/$(BENCH_TARGET).d

# Header dependencies (public + impl/)
HEADERS := $(wildcard $(INCLUDEDIR)/*.hpp) $(wildcard $(INCLUDEDIR)/impl/*.hpp)

# Targets built by `make all`. Bench is on-demand only (`make bench`) so
# routine builds / CI are not slowed by timing harness compiles.
TARGETS :=
ifeq ($(ENABLE_TESTS),yes)
    TARGETS += $(OBJDIR)/$(TESTER_TARGET)
endif
ifeq ($(ENABLE_DEMO),yes)
    TARGETS += $(DEMO_TARGETS)
endif

# Default target
.DEFAULT_GOAL := all

# Phony targets
.PHONY: all clean test demo bench profile install uninstall help check-config

all: check-config $(TARGETS)
	$(Q)if [ -n "$(TARGETS)" ]; then \
		echo "Build complete ($(BUILD_TYPE) mode)"; \
	else \
		echo "Nothing to build (tests and demo disabled)"; \
	fi

# Check if configuration looks reasonable
check-config:
	$(Q)if [ ! -f config.mk ]; then \
		echo ""; \
		echo "NOTE: Running with default configuration."; \
		echo "      For customized build, run: ./configure [options]"; \
		echo ""; \
	fi

# Create object directory
$(OBJDIR):
	$(ECHO) "  MKDIR   $(OBJDIR)"
	$(Q)mkdir -p $(OBJDIR)

# Build tester (enable PoolStats success/fail counters for metrics tests).
# -U then -D so we override config.mk's SPALLOCATOR_POOL_COUNTERS=0 without
# -Werror,-Wmacro-redefined.
$(OBJDIR)/$(TESTER_TARGET): $(TESTER_SRC) $(HEADERS) | $(OBJDIR)
	$(ECHO) "  CXX     $@"
	$(Q)$(CXX) $(CXXFLAGS) -USPALLOCATOR_POOL_COUNTERS -DSPALLOCATOR_POOL_COUNTERS=1 $< -o $@ $(LDFLAGS)
	$(Q)rm -f $(BASEOBJDIR)/$(TESTER_TARGET)
	$(Q)ln -s $(OBJDIRNAME)/$(TESTER_TARGET) $(BASEOBJDIR)/$(TESTER_TARGET)
ifeq ($(ENABLE_COVERAGE),yes)
	# Stale .gcda cannot merge after instrumentation changes (corrupt arc tag).
	$(Q)rm -f $(OBJDIR)/*.gcda $(OBJDIR)/*.gcov
endif

# Build demos (one binary per demos/demo_*.cpp listed in DEMO_NAMES)
$(OBJDIR)/demo_%: $(DEMODIR)/demo_%.cpp $(HEADERS) | $(OBJDIR)
	$(ECHO) "  CXX     $@"
	$(Q)$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS)
	$(Q)rm -f $(BASEOBJDIR)/$(@F)
	$(Q)ln -s $(OBJDIRNAME)/$(@F) $(BASEOBJDIR)/$(@F)

# Run tests
test: $(OBJDIR)/$(TESTER_TARGET)
ifeq ($(ENABLE_COVERAGE),yes)
	# Fresh counters for this run (avoids merge with older .gcda after edits).
	$(Q)rm -f $(OBJDIR)/*.gcda
endif
	$(ECHO) "  RUN     $(TESTER_TARGET)"
	$(Q)$(OBJDIR)/$(TESTER_TARGET)

# Coverage summary (ENABLE_COVERAGE=yes). Clang → llvm-cov; GCC → gcov.
# Tool versions come from PATH / update-alternatives — no version probing here.
# `test` already clears .gcda before the run when coverage is enabled.
coverage: test
ifeq ($(ENABLE_COVERAGE),yes)
	$(ECHO) "  COVERAGE $(OBJDIR)"
	$(Q)set -e; \
	is_clang="$(IS_CLANG)"; \
	if [ "$$is_clang" != "yes" ] && $(CXX) --version 2>/dev/null | grep -qi clang; then \
		is_clang=yes; \
	fi; \
	stem="$(TESTER_TARGET)-$(TESTER_TARGET)"; \
	if [ ! -f "$(OBJDIR)/$$stem.gcda" ]; then stem="$(TESTER_TARGET)"; fi; \
	if [ ! -f "$(OBJDIR)/$$stem.gcda" ]; then \
		echo "No coverage data in $(OBJDIR) — rebuild with ENABLE_COVERAGE=yes"; \
		exit 1; \
	fi; \
	rm -f "$(OBJDIR)"/*.gcov; \
	cd $(OBJDIR); \
	if [ "$$is_clang" = "yes" ]; then \
		llvm-cov gcov -o . "$$stem"; \
	else \
		gcov -o . "$$stem"; \
	fi 2>&1 | awk '/^File '\''(spallocator|test)\//{show=1; print; next} \
		show && /Lines executed/{print; show=0}' || true; \
	echo "Coverage notes under $(OBJDIR)/*.gcov"
else
	@echo "Coverage disabled (ENABLE_COVERAGE=$(ENABLE_COVERAGE); use --enable-coverage or BUILD_TYPE=release)"
endif

# Run demos
demo: $(DEMO_TARGETS)
	$(Q)for t in $(DEMO_NAMES); do \
		echo "  RUN     $$t"; \
		$(OBJDIR)/$$t; \
	done

# Build on-demand allocator comparison bench (not part of `all` / `test`).
$(OBJDIR)/$(BENCH_TARGET): $(BENCH_SRC) $(HEADERS) | $(OBJDIR)
ifeq ($(ENABLE_BENCH),yes)
	$(ECHO) "  CXX     $@"
	$(Q)$(CXX) $(CXXFLAGS) $< -o $@ $(LDFLAGS) -pthread
	$(Q)rm -f $(BASEOBJDIR)/$(BENCH_TARGET)
	$(Q)ln -s $(OBJDIRNAME)/$(BENCH_TARGET) $(BASEOBJDIR)/$(BENCH_TARGET)
else
	@echo "Bench disabled (ENABLE_BENCH=$(ENABLE_BENCH))"
	@exit 1
endif

# Run bench (prefer BUILD_TYPE=release for meaningful ratios).
# Coverage is forced off when the `bench` goal is present (see top of Makefile).
bench: $(OBJDIR)/$(BENCH_TARGET)
	$(ECHO) "  RUN     $(BENCH_TARGET) $(BENCH_ARGS)"
	$(Q)$(OBJDIR)/$(BENCH_TARGET) $(BENCH_ARGS)

# Profile build + perf record/report. Forces BUILD_TYPE=profile via MAKECMDGOALS.
# Example:
#   make profile BENCH_ARGS='--scenario=lifo --backend=slab16 --iters=2000000'
PERF ?= perf
PERF_RECORD_ARGS ?= record -g --call-graph fp --freq=999
PERF_DATA ?= $(OBJDIR)/perf.data

profile: $(OBJDIR)/$(BENCH_TARGET)
	$(ECHO) "  PERF    $(PERF_RECORD_ARGS) -o $(PERF_DATA) -- $(BENCH_TARGET) $(BENCH_ARGS)"
	$(Q)command -v $(PERF) >/dev/null 2>&1 || { \
		echo "perf not found (install linux-tools / perf)."; \
		echo "Profile binary ready: $(OBJDIR)/$(BENCH_TARGET)"; \
		exit 1; \
	}
	$(Q)if ! $(PERF) $(PERF_RECORD_ARGS) -o $(PERF_DATA) -- $(OBJDIR)/$(BENCH_TARGET) $(BENCH_ARGS); then \
		echo ""; \
		echo "perf record failed (often kernel.perf_event_paranoid is too strict)."; \
		echo "Profile binary is ready: $(OBJDIR)/$(BENCH_TARGET)"; \
		echo "  $(OBJDIR)/$(BENCH_TARGET) $(BENCH_ARGS)"; \
		echo "Then, after allowing perf for your user, re-run:"; \
		echo "  make profile BENCH_ARGS='$(BENCH_ARGS)'"; \
		echo "Or: sudo sysctl kernel.perf_event_paranoid=1   # temporary; prefer 1 or 2"; \
		exit 1; \
	fi
	$(ECHO) "  PERF    report -i $(PERF_DATA) (top symbols)"
	$(Q)$(PERF) report -i $(PERF_DATA) --stdio --no-children -n --percent-limit 1 | head -n 60
	@echo "Full report: $(PERF) report -i $(PERF_DATA)"
	@echo "Hotspot GUI: hotspot $(PERF_DATA)"

# Install (header-only library)
install:
	$(ECHO) "  INSTALL headers to $(PREFIX)/include/spallocator"
	$(Q)install -d $(PREFIX)/include/spallocator
	$(Q)install -d $(PREFIX)/include/spallocator/impl
	$(Q)install -m 644 $(INCLUDEDIR)/*.hpp $(PREFIX)/include/spallocator/
	$(Q)install -m 644 $(INCLUDEDIR)/impl/*.hpp $(PREFIX)/include/spallocator/impl/
	$(ECHO) "  INSTALL docs/LICENSE to $(PREFIX)/share/doc/spallocator"
	$(Q)install -d $(PREFIX)/share/doc/spallocator
	$(Q)install -m 644 LICENSE README.md $(PREFIX)/share/doc/spallocator/
	$(Q)install -m 644 $(APIDOCS)/API.md $(APIDOCS)/CONCEPTS.md \
		$(APIDOCS)/IMPLEMENTATION.md $(PREFIX)/share/doc/spallocator/
	$(Q)if [ -d $(DOCDIR) ]; then \
		install -m 644 $(DOCDIR)/*.md $(PREFIX)/share/doc/spallocator/; \
	fi
	$(ECHO) "Installation complete!"

# Uninstall
uninstall:
	$(ECHO) "  REMOVE  $(PREFIX)/include/spallocator"
	$(Q)rm -rf $(PREFIX)/include/spallocator
	$(ECHO) "  REMOVE  $(PREFIX)/share/doc/spallocator"
	$(Q)rm -rf $(PREFIX)/share/doc/spallocator
	$(ECHO) "Uninstallation complete!"

# Clean build artifacts
clean:
	$(ECHO) "  CLEAN   $(OBJDIR)"
	$(Q)rm -f $(OBJDIR)/$(TESTER_TARGET) $(DEMO_TARGETS) $(OBJDIR)/$(BENCH_TARGET)
	$(Q)rm -f $(OBJDIR)/*.o $(OBJDIR)/*.d $(OBJDIR)/*.gcda $(OBJDIR)/*.gcno $(OBJDIR)/*.gcov
	$(Q)rm -f $(OBJDIR)/perf.data $(OBJDIR)/perf.data.old
	$(Q)rm -f $(BASEOBJDIR)/$(TESTER_TARGET) $(addprefix $(BASEOBJDIR)/,$(DEMO_NAMES)) \
		$(BASEOBJDIR)/$(BENCH_TARGET)
	$(Q)rm -f *.gcov *.gcda *.gcno
	$(ECHO) "Clean complete!"

# Distclean - remove generated files
distclean: clean
	$(ECHO) "  CLEAN   config.mk"
	$(Q)rm -f config.mk
	$(Q)rm -rf $(BASEOBJDIR)

# Help target
help:
	@echo "Slab Pool Allocator - Build Targets"
	@echo ""
	@echo "Configuration:"
	@echo "  ./configure [options]  - Configure the build (run before make)"
	@echo "  make help              - Show this help"
	@echo ""
	@echo "Build targets:"
	@echo "  make                   - Build all enabled targets"
	@echo "  make all               - Same as 'make'"
	@echo "  make test              - Run test suite"
	@echo "  make coverage          - Run tests and print gcov summary (release default)"
	@echo "  make demo              - Run demo programs"
	@echo "  make bench             - Build/run allocator comparison bench (on-demand)"
	@echo "  make profile           - Build profile binary + perf record/report (on-demand)"
	@echo "  make clean             - Remove build artifacts"
	@echo "  make distclean         - Remove all generated files"
	@echo ""
	@echo "Bench tips:"
	@echo "  make bench BUILD_TYPE=release"
	@echo "  make bench BUILD_TYPE=release BENCH_ARGS='--threads=4'"
	@echo "  make bench BUILD_TYPE=release BENCH_ARGS='--align=32'"
	@echo "  make bench BUILD_TYPE=release BENCH_ARGS='--align=64'"
	@echo "  make bench BUILD_TYPE=release BENCH_ARGS='--scenario=lifo --backend=pool'"
	@echo "  make bench BUILD_TYPE=release BENCH_ARGS='--scenario=threaded --threads=4'  # batch=1024,size-mix=class"
	@echo "  make profile BENCH_ARGS='--scenario=lifo --backend=slab16 --iters=2000000'"
	@echo ""
	@echo "Installation:"
	@echo "  make install           - Install headers and docs to PREFIX"
	@echo "  make uninstall         - Remove installed files"
	@echo ""
	@echo "Build type selection (without configure):"
	@echo "  make BUILD_TYPE=debug"
	@echo "  make BUILD_TYPE=release"
	@echo "  make BUILD_TYPE=profile    # release + -g -fno-omit-frame-pointer (for perf)"
	@echo "  make BUILD_TYPE=addrsan    # AddressSanitizer + LSan + UBSan (default), implies debug"
	@echo "  make BUILD_TYPE=memsan     # MemorySanitizer + UBSan, implies debug"
	@echo "  make BUILD_TYPE=threadsan  # ThreadSanitizer (UBSan opt-in), implies debug"
	@echo ""
	@echo "Current configuration:"
	@echo "  Build type:    $(BUILD_TYPE)"
	@echo "  Compiler:      $(CXX)"
	@echo "  Tests:         $(ENABLE_TESTS)"
	@echo "  Demo:          $(ENABLE_DEMO)"
	@echo "  Bench:         $(ENABLE_BENCH)"
	@echo "  Prefix:        $(PREFIX)"
	@echo ""

# Include generated dependency files
-include $(TESTER_DEPFILE)
-include $(BENCH_DEPFILE)
